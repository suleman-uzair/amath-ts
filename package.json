{
  "name": "@plurimath/amath-ts",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "AsciiMath parser for TypeScript: PARG artifact runtime port of amath (parsanol wasm)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:artifacts": "node scripts/verify-artifacts.mjs",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "parsanol": "git+https://github.com/suleman-uzair/parsanol-ts.git#42aeb8fb4773b7e11d0e52bdf5c7e4b34bf5efa4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/unitsml/amath-ts"
  },
  "files": [
    "dist/",
    "artifacts/",
    "grammars/",
    "model/",
    "LICENSE.md",
    "data/"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./artifacts/*": "./artifacts/*"
  }
}
